# Polymarket API Credentials
# Get from: https://clob.polymarket.com/settings
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_PASSPHRASE=your_passphrase_here

# Wallet Configuration
# PRIVATE_KEY=your_wallet_private_key_here (Optional: Only needed for automatic merging)
PROXY_WALLET_ADDRESS=your_gnosis_safe_address_here

# Polygon RPC
# Mainnet
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_key
# Testnet (Amoy)
POLYGON_TESTNET_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_key

# Trading Parameters
PROFIT_THRESHOLD=0.008
SINGLE_TRADE_SIZE=100
MAX_SLIPPAGE=0.002
MERGE_INTERVAL=600

# Rate Limiting
API_RATE_LIMIT=10

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Environment
ENV=production
