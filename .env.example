# ╔══════════════════════════════════════════════════════════════════════╗
# ║        Prediction Market Arbitrage Bot — 环境变量配置               ║
# ║        预测市场套利机器人（Polymarket + Azuro 跨平台套利）            ║
# ╚══════════════════════════════════════════════════════════════════════╝
# 将此文件复制为 .env 并填入你的实际值。
# Copy this file to .env and fill in your actual values.

# ═══════════════════════════════════════════════════════════════════════
# 1. CLOB API 凭证 (Polymarket Central Limit Order Book)
# ═══════════════════════════════════════════════════════════════════════
# 用于通过 CLOB API 提交订单和查询账户信息。
# 如果没有，可以通过 gen_creds.py 脚本从私钥自动派生。
# 运行: python gen_creds.py
POLYMARKET_API_KEY=your_api_key_here (Optional: can be derived from PRIVATE_KEY)
POLYMARKET_API_SECRET=your_api_secret_here (Optional: can be derived from PRIVATE_KEY)
POLYMARKET_PASSPHRASE=your_passphrase_here (Optional: can be derived from PRIVATE_KEY)

# Signature type: 0=EOA, 1=POLY_PROXY, 2=POLY_GNOSIS_SAFE (MetaMask login uses 2)
SIGNATURE_TYPE=2

# ═══════════════════════════════════════════════════════════════════════
# 2. 钱包配置 (Wallet)
# ═══════════════════════════════════════════════════════════════════════
# PRIVATE_KEY: 标准以太坊/Polygon EOA 私钥 (0x 开头的 hex 字符串)。
#   - 可通过 MetaMask 导出: 账户详情 → 导出私钥
#   - 也可导入到 MetaMask: Import Account → 粘贴私钥
#   - ⚠️ 建议使用专用交易钱包，不要使用存有大量资产的主钱包
#   - ⚠️ 若启用 Azuro 跨平台套利,同一私钥用于签署 Azuro LP.bet() 链上交易
PRIVATE_KEY=your_wallet_private_key_here

# PROXY_WALLET_ADDRESS: Polymarket 为你创建的 Gnosis Safe 代理钱包地址。
#   - 在 Polymarket 网站注册并连接钱包后自动创建
#   - 可在 Polymarket 钱包设置页面找到
#   - CLOB API 的交易实际发生在这个代理钱包上
PROXY_WALLET_ADDRESS=your_gnosis_safe_address_here

# ═══════════════════════════════════════════════════════════════════════
# 3. Polygon RPC 节点
# ═══════════════════════════════════════════════════════════════════════
# 用于链上交互（Settler 合并操作、CTF 合约调用、Azuro 下注）。
# 推荐使用 Alchemy、Infura 或 QuickNode 等节点服务。
# 主网 (Mainnet) — 实盘交易使用
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_key
# 测试网 (Amoy Testnet) — 仅 ENV=testnet 时使用
POLYGON_TESTNET_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_key

# ═══════════════════════════════════════════════════════════════════════
# 4. Builder Program 凭证 (可选 — 启用 Relayer 无 Gas 合并)
# ═══════════════════════════════════════════════════════════════════════
# 用于通过 Polymarket Relayer API 提交 gasless meta-transaction 进行持仓合并。
# 不配置时，Settler 使用 EOA 直签模式（钱包需持有 POL 支付 Gas）。
# 获取方式: 申请 Polymarket Builder Program → https://docs.polymarket.com/#builder-program
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=

# RELAYER_TX_TYPE: Relayer 交易类型（仅在配置了 Builder 凭证时生效）
#   - "PROXY": 通过 Polymarket Proxy Wallet (即 PROXY_WALLET_ADDRESS 对应的
#     Gnosis Safe) 执行交易。绝大多数用户应使用此选项（推荐）。
#   - "SAFE": 直接以独立部署的 Gnosis Safe 合约身份执行，适用于自行管理
#     Safe 合约的高级用户。
RELAYER_TX_TYPE=PROXY

# ═══════════════════════════════════════════════════════════════════════
# 5. 交易参数 (Trading Parameters)
# ═══════════════════════════════════════════════════════════════════════
# PROFIT_THRESHOLD: 最低净利润率阈值，低于此值不触发交易。
#   范围: 0.001 ~ 0.1 | 默认: 0.008 (0.8%)
#   保守: 0.015 (1.5%) | 平衡: 0.008 (0.8%) | 激进: 0.003 (0.3%)
PROFIT_THRESHOLD=0.008

# SINGLE_TRADE_SIZE: 每次套利投入的 USDC 总金额。
#   NegRisk 策略会按结果数平分。范围: 1 ~ 10000 | 默认: 100
SINGLE_TRADE_SIZE=100

# MAX_SLIPPAGE: 最大允许滑点（加权均价与最优价的偏差上限）。
#   范围: 0.0001 ~ 0.05 | 默认: 0.002 (0.2%)
MAX_SLIPPAGE=0.002

# MERGE_INTERVAL: Settler 自动检查持仓并合并的周期（秒）。
#   范围: 60 ~ 3600 | 默认: 600 (10 分钟)
MERGE_INTERVAL=600

# ═══════════════════════════════════════════════════════════════════════
# 6. API 限速 (Rate Limiting)
# ═══════════════════════════════════════════════════════════════════════
# Scanner 和 Executor 对 Polymarket API 的请求速率上限（每秒请求数）。
#   范围: 1 ~ 100 | 默认: 10
API_RATE_LIMIT=10

# ═══════════════════════════════════════════════════════════════════════
# 7. 通知渠道 (Notifications — 均为可选)
# ═══════════════════════════════════════════════════════════════════════
# 支持 Telegram、企业微信、或同时发送。均不配置时仅写日志。

# Telegram: 通过 @BotFather 创建 Bot 获取 Token，Chat ID 为目标群组/用户 ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 企业微信群机器人 Webhook URL（详见 企业微信消息推送配置说明.md）
WECHAT_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════════════
# 8. 市场刷新 (Market Refresh)
# ═══════════════════════════════════════════════════════════════════════
# 定期重新通过 Gamma API 扫描新市场/事件的间隔（秒）。
#   设为 0 禁用自动刷新。默认: 1800 (30 分钟)
MARKET_REFRESH_INTERVAL=1800

# ═══════════════════════════════════════════════════════════════════════
# 9. 运行模式 (Runtime)
# ═══════════════════════════════════════════════════════════════════════
# DRY_RUN: 模拟运行模式。设为 true 时不执行真实交易和链上合并，
#   使用虚拟 $10,000 余额。建议首次运行至少 dry-run 24 小时。
#   也可通过命令行 --dry-run 开启。
DRY_RUN=false

# LOG_LEVEL: 日志级别。也可通过命令行 --log-level 覆盖。
#   可选: DEBUG / INFO / WARNING / ERROR | 默认: INFO
LOG_LEVEL=INFO

# ENV: 运行环境。production 使用主网，testnet 使用 Amoy 测试网。
#   也可通过命令行 --env 覆盖。
ENV=production

# ═══════════════════════════════════════════════════════════════════════
# 10. Azuro 交易所配置 (可选 — 启用跨平台套利)
# ═══════════════════════════════════════════════════════════════════════
# Azuro 是基于 Polygon 的预测市场协议，使用 AMM（自动做市商）定价。
# 与 Polymarket 的 CLOB 订单簿不同，Azuro 通过流动性池提供赔率。
# 启用后可对同一体育赛事进行跨平台价格比较和套利。
#
# ⚠️ 前提条件:
#   1. PRIVATE_KEY 已配置（签署 Azuro 链上交易需要）
#   2. 钱包持有足够 USDC (Polygon) 和少量 POL (支付 Gas)
#   3. POLYGON_RPC_URL 已配置（推荐 Alchemy/Infura 付费节点以获得稳定性）

# AZURO_ENABLED: 是否启用 Azuro 交易所适配器。
#   设为 true 后,机器人会连接 Azuro 子图获取赛事数据。
#   默认: false
AZURO_ENABLED=false

# AZURO_LP_ADDRESS: Polygon V3 USDC 流动性池合约
# 这是目前下注 (lp.bet) 最主要的入口, 使用 USDC 结算。
# 来源: Azuro V3 Expressive 官方部署地址。
AZURO_LP_ADDRESS=0x70430f9e160f2795A987019597F748805f77876A

# AZURO_CORE_ADDRESS: Polygon V3 Expressive Core 合约
# 该合约管理赔率和下注逻辑，与上述 LP 配套使用。
AZURO_CORE_ADDRESS=0x204e73160d061941c027563285F36544BA95c393

# AZURO_SUBGRAPH_URL: 数据抓取端点 (Data Feed)
# 注意: 该子图仅用于查询赔率和赛事(games/conditions), 不包含合约列表字段。
# 如果执行查询报错 "no field liquidityPools", 请改用 core 子图或直接使用上述硬编码地址。
AZURO_SUBGRAPH_URL=https://thegraph-1.onchainfeed.org/subgraphs/name/azuro-protocol/azuro-data-feed-polygon

# ═══════════════════════════════════════════════════════════════════════
# 11. 跨平台套利参数 (Cross-Platform Arbitrage)
# ═══════════════════════════════════════════════════════════════════════
# 跨平台套利在 Polymarket 和 Azuro 之间寻找价差：
#   在一个平台买 YES，另一个平台买 NO，锁定无风险利润。
#
# ⚠️ 前提条件:
#   1. AZURO_ENABLED=true
#   2. AZURO_LP_ADDRESS 和 AZURO_CORE_ADDRESS 已配置
#   3. 钱包在两个平台均有足够余额（USDC on Polygon）
#
# ⚠️ 风险提醒:
#   Azuro 下注后生成 NFT 凭证，无法像 Polymarket 订单簿一样即时卖出。
#   如果一条腿成功、另一条失败（"断腿"），Azuro 侧只能持有至赛事结算。
#   因此跨平台利润阈值默认 3%，远高于平台内的 0.8%。

# CROSS_PLATFORM_ENABLED: 是否启用跨平台套利扫描和执行。
#   需要同时启用 AZURO_ENABLED=true。默认: false
CROSS_PLATFORM_ENABLED=false

# CROSS_PROFIT_THRESHOLD: 跨平台最低净利润率阈值。
#   高于平台内阈值,以补偿 Azuro 断腿无法即时退出的风险。
#   范围: 0.005 ~ 0.2 | 默认: 0.03 (3%)
#   保守: 0.05 (5%) | 平衡: 0.03 (3%) | 激进: 0.015 (1.5%)
CROSS_PROFIT_THRESHOLD=0.03

# CROSS_TRADE_SIZE: 跨平台单笔套利投入的 USDC 总金额。
#   此金额会平分到两条腿（YES 腿 + NO 腿各一半）。
#   建议从小金额开始测试。范围: 5 ~ 5000 | 默认: 50
CROSS_TRADE_SIZE=50

# ALIGNMENT_USE_LLM: 是否启用 LLM（大语言模型）进行事件名称模糊匹配。
#   默认使用结构化规则（球队名标准化 + 时间邻近度）匹配事件。
#   启用 LLM 可提高匹配率，但会增加延迟和 API 调用成本。
#   默认: false
ALIGNMENT_USE_LLM=false

# LLM_API_KEY: LLM API 密钥（仅在 ALIGNMENT_USE_LLM=true 时需要）。
#   支持任何 OpenAI 兼容 API（OpenAI、DeepSeek、Moonshot、通义千问等）。
#   ─────────────────────────────────────────────────────────────────────
#   各平台获取方式:
#     OpenAI:    https://platform.openai.com/api-keys
#     DeepSeek:  https://platform.deepseek.com/api_keys
#     Moonshot:  https://platform.moonshot.cn/console/api-keys
#     通义千问:  https://dashscope.console.aliyun.com/apiKey
#   ─────────────────────────────────────────────────────────────────────
LLM_API_KEY=

# LLM_BASE_URL: LLM API 基础 URL。
#   不同提供商的端点不同,需要与 API Key 匹配。
#   ─────────────────────────────────────────────────────────────────────
#   常用端点:
#     OpenAI:    https://api.openai.com/v1             (默认值)
#     DeepSeek:  https://api.deepseek.com/v1
#     Moonshot:  https://api.moonshot.cn/v1
#     通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   ─────────────────────────────────────────────────────────────────────
#   默认: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# LLM_MODEL: 使用的模型名称。
#   需要与你选择的 API 提供商可用的模型匹配。
#   ─────────────────────────────────────────────────────────────────────
#   推荐模型 (事件对齐任务,无需顶级推理能力,建议用快速便宜的模型):
#     OpenAI:    gpt-4o-mini (默认,速度快/便宜) 或 gpt-4o
#     DeepSeek:  deepseek-chat (性价比高,推荐)
#     Moonshot:  moonshot-v1-8k
#     通义千问:  qwen-turbo
#   ─────────────────────────────────────────────────────────────────────
#   默认: gpt-4o-mini
LLM_MODEL=gpt-4o-mini
